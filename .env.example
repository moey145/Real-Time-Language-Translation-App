# Copy this file to .env and add your key. Never commit .env.

# The only key the app needs: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-haiku-5-5     # claude-sonnet-5-5 or claude-opus-5-5 for higher quality at higher cost
# CLAUDE_EFFORT=low                 # low | medium | high | xhigh | max
# CONTEXT_TURNS=6
# MAX_TEXT_CHARS=2000
# MAX_REQUESTS_PER_MINUTE=40
